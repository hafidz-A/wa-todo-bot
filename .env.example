# Salin jadi .env lalu isi.

# API key dari console.anthropic.com
ANTHROPIC_API_KEY=

# Nomor WhatsApp kamu (satu-satunya yang dilayani bot), format 62…
OWNER_NUMBER=628xxxxxxxxxx

# Opsional: nomor bot, kalau mau login pakai kode pairing (tanpa scan QR)
BOT_NUMBER=

# Opsional
# CLAUDE_MODEL=claude-sonnet-5-5
# CLAUDE_EFFORT=medium            # low lebih hemat & cepat, high lebih teliti
# TIMEZONE=Asia/Jakarta
# DIGEST_TIME=07:00               # jam rekap pagi; kosongkan untuk mematikan
# DEFAULT_REMINDERS=1440,180,30,0 # menit sebelum deadline
# TRASH_DAYS=7                    # lama item di tempat sampah sebelum dihapus permanen
# DEBUG=1                         # tampilkan log pemanggilan AI & tools
